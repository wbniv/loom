#!/usr/bin/env bash
# Loom masked-generation experiment, Phase A — remote runner (GCP).
#
# Rendered by Terraform (infrastructure/gcp/modules/experiment-runner). Bash
# variables are written without braces so Terraform's own dollar-brace
# interpolation does not collide with them; where braces are unavoidable they
# are escaped by doubling the dollar sign.
set -euo pipefail

exec > >(tee -a /var/log/loom-experiment.log) 2>&1

BUCKET="${artifacts_bucket}"
RUN_ID="${run_id}"
ZONE="${zone}"
INSTANCE_NAME="${instance_name}"
LLAMA_REPO="${llama_cpp_repo}"
LLAMA_REV="${llama_cpp_revision}"
GGUF_FILENAME="${gguf_filename}"
MODEL_IDENTITY="${model_identity}"
HARDWARE="${hardware}"
NGL="${n_gpu_layers}"
CTX="${context_size}"
PARALLEL="${parallel_slots}"
CONFIG_KEY="${remote_config_key}"
OUTPUT_DIR="${remote_output_dir}"

export DEBIAN_FRONTEND=noninteractive
export CLOUDSDK_CORE_DISABLE_PROMPTS=1

WORK=/opt/loom
LOG=/var/log/loom-experiment.log
SERVER_LOG=/var/log/llama-server.log
STATUS=FAILED

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

finish() {
  local code=$?
  set +e
  log "finish: exit code $code, status $STATUS"

  # Results first, then the logs, then the marker. The driver only reads the
  # marker once the objects it names are already in place.
  if [ -d "$WORK/repo/prototype/$OUTPUT_DIR" ]; then
    gsutil -q -m rsync -r "$WORK/repo/prototype/$OUTPUT_DIR" "gs://$BUCKET/results/$RUN_ID/runs/"
  fi
  gsutil -q cp "$LOG" "gs://$BUCKET/results/$RUN_ID/logs/startup-script.log"
  if [ -f "$SERVER_LOG" ]; then
    gsutil -q cp "$SERVER_LOG" "gs://$BUCKET/results/$RUN_ID/logs/llama-server.log"
  fi
  printf '%s\n' "$STATUS" | gsutil -q cp - "gs://$BUCKET/status/$RUN_ID.txt"

  # Escape hatch: `gsutil cp - gs://BUCKET/control/RUN_ID.nohalt </dev/null`
  # from the operator's laptop keeps a failing box alive for inspection.
  if gsutil -q stat "gs://$BUCKET/control/$RUN_ID.nohalt" 2>/dev/null; then
    log "finish: nohalt marker present, leaving the instance running"
    return
  fi

  # Self-delete, so a driver that was killed outright still does not leave a
  # GPU standing. The instance role is conditioned on this instance's own name.
  # If the call is refused, fall back to halting: a stopped Spot VM with
  # instance_termination_action = DELETE still costs only its boot disk, and
  # the driver's teardown removes that on every exit path.
  log "finish: deleting this instance"
  if ! gcloud compute instances delete "$INSTANCE_NAME" --zone "$ZONE" --quiet; then
    log "finish: self-delete refused, halting instead"
    shutdown -h now
  fi
}
trap finish EXIT

log "runner starting: run_id=$RUN_ID bucket=$BUCKET zone=$ZONE"

# --- 0. Wait for the NVIDIA driver ------------------------------------------
# The DLVM image stages the driver and installs it from the
# install-nvidia-driver metadata key during boot, which can finish after this
# script starts. Compiling against a toolkit whose kernel module is not loaded
# yet works, but running does not, so wait here where the failure is legible.
log "waiting for the NVIDIA driver"
for attempt in $(seq 1 60); do
  if nvidia-smi >/dev/null 2>&1; then
    log "driver ready after $attempt attempts"
    break
  fi
  sleep 10
done
nvidia-smi || log "warning: nvidia-smi still failing; continuing so the log records why"

# --- 1. Build dependencies --------------------------------------------------
# The Deep Learning VM image already carries the NVIDIA driver, the CUDA
# toolkit (nvcc under /usr/local/cuda) and the Google Cloud SDK. Only the build
# tooling is missing.
log "installing build dependencies"
apt-get update -y
apt-get install -y --no-install-recommends \
  build-essential cmake git ccache pkg-config libcurl4-openssl-dev python3 python3-venv jq

export PATH=/usr/local/cuda/bin:$PATH
export CUDACXX=/usr/local/cuda/bin/nvcc
nvcc --version

# --- 2. Repo tarball --------------------------------------------------------
log "fetching the repo tarball"
mkdir -p "$WORK/repo"
gsutil -q cp "gs://$BUCKET/repo/repo.tar.gz" /tmp/repo.tar.gz
tar -xzf /tmp/repo.tar.gz -C "$WORK/repo"

# --- 3. Models --------------------------------------------------------------
log "fetching models"
mkdir -p "$WORK/models"
gsutil -q -m rsync -r "gs://$BUCKET/models/" "$WORK/models/"

if [ -n "$GGUF_FILENAME" ]; then
  MODEL_PATH="$WORK/models/$GGUF_FILENAME"
else
  MODEL_PATH="$(find "$WORK/models" -maxdepth 1 -name '*.gguf' | sort | head -n 1)"
fi
if [ -z "$MODEL_PATH" ] || [ ! -f "$MODEL_PATH" ]; then
  log "no GGUF found under $WORK/models — nothing to serve"
  exit 1
fi
log "model: $MODEL_PATH"

# --- 4. llama.cpp at the pinned revision ------------------------------------
# Revision-keyed build cache: hit -> ~30 s extract; miss -> build once and
# seed the cache for every later run. The cache is an optimization, never a
# dependency: any cache failure falls through to a source build, and a
# failed upload never fails a successful run.
BUILD_CACHE="gs://$BUCKET/builds/llama-$LLAMA_REV-cu129-g2.tar.gz"
git clone "$LLAMA_REPO" "$WORK/llama.cpp"
git -C "$WORK/llama.cpp" checkout --detach "$LLAMA_REV"
if gsutil -q stat "$BUILD_CACHE" 2>/dev/null && \
   gsutil -q cp "$BUILD_CACHE" /tmp/llama-build.tar.gz && \
   tar -xzf /tmp/llama-build.tar.gz -C "$WORK/llama.cpp" && \
   test -x "$WORK/llama.cpp/build/bin/llama-server"; then
  log "build cache hit: $BUILD_CACHE"
else
  log "build cache miss — building llama.cpp at $LLAMA_REV with CUDA"
  rm -rf "$WORK/llama.cpp/build"
  cmake -S "$WORK/llama.cpp" -B "$WORK/llama.cpp/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DLLAMA_CURL=OFF \
    -DLLAMA_BUILD_TESTS=OFF
  cmake --build "$WORK/llama.cpp/build" --config Release --target llama-server -j "$(nproc)"
  (cd "$WORK/llama.cpp" && tar czf - build | gsutil -q cp - "$BUILD_CACHE") \
    && log "build cache seeded: $BUILD_CACHE" \
    || log "build cache upload failed (continuing — cache is best-effort)"
fi

SERVER_BIN="$WORK/llama.cpp/build/bin/llama-server"
test -x "$SERVER_BIN"

# --- 5. llama-server --------------------------------------------------------
log "starting llama-server"
"$SERVER_BIN" \
  --model "$MODEL_PATH" \
  --host 127.0.0.1 --port 8080 \
  -ngl "$NGL" -c "$CTX" --parallel "$PARALLEL" \
  > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

log "waiting for llama-server health"
for attempt in $(seq 1 120); do
  if curl -sf http://127.0.0.1:8080/health >/dev/null; then
    log "llama-server healthy after $attempt attempts"
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    log "llama-server died during startup"
    tail -n 100 "$SERVER_LOG"
    exit 1
  fi
  sleep 5
done
curl -sf http://127.0.0.1:8080/health >/dev/null

# --- 6. Remote config -------------------------------------------------------
# The operator's own Phase A config travels up untouched; only the backend
# seam, the recorded identity fields and the output directory are rewritten
# here, so the matrix that runs remotely is the matrix they configured.
log "patching the run config"
gsutil -q cp "gs://$BUCKET/$CONFIG_KEY" "$WORK/run.config.json"

MODEL_IDENTITY="$MODEL_IDENTITY" HARDWARE="$HARDWARE" OUTPUT_DIR="$OUTPUT_DIR" \
  python3 - "$WORK/run.config.json" "$WORK/repo/prototype/experiment/remote.config.json" <<'PY'
import json
import os
import sys

source, target = sys.argv[1], sys.argv[2]
with open(source, encoding="utf-8") as handle:
    config = json.load(handle)

config["backend"] = "llama-server"
config["server_url"] = "http://127.0.0.1:8080"
config["model_identity"] = os.environ["MODEL_IDENTITY"]
config["hardware"] = os.environ["HARDWARE"]
config["output_dir"] = os.environ["OUTPUT_DIR"]
config.pop("binary", None)
config.pop("model_path", None)

with open(target, "w", encoding="utf-8") as handle:
    json.dump(config, handle, indent=2, sort_keys=True)
    handle.write("\n")
print(json.dumps(config, indent=2, sort_keys=True))
PY

# --- 7. The run -------------------------------------------------------------
# `experiment.runner` writes records.jsonl incrementally and resumes from it, so
# a re-run against a restored output directory picks up where a preempted run
# stopped rather than repeating finished cells.
log "running the Phase A matrix"
cd "$WORK/repo/prototype"
python3 -m experiment.runner --config experiment/remote.config.json

STATUS=SUCCEEDED
log "run complete"
