# Canonical Loom generation surface. Whitespace and spelling are deliberately
# fixed so each accepted string is the renderer's normal form. The optional
# final newline accommodates ordinary text files. Row ordering, scope, typing,
# exhaustiveness, and semantic obligations remain transcoder/oracle checks.

root        ::= "(def " type " " term ")" "\n"?

type        ::= (base
              | "(data " hash " " type-list ")"
              | "(fn " type " " row " " type ")"
              | "(refine " type " " term ")"
              | "(cap " hash ")"
              | "(tyvar " uint ")"
              | "(forall " type ")")
base        ::= "Unit" | "Bool" | "I64" | "F64" | "Text" | "Bytes"
type-list   ::= "(" (type (" " type)*)? ")"
row         ::= "(" (hash (" " hash)* (" " row-var)? | row-var)? ")"
row-var     ::= "(tyvar " uint ")"

term        ::= ("(var " uint ")"
              | "(ref " hash ")"
              | literal
              | "(lam " type " " term ")"
              | "(app " term " " term ")"
              | "(let " type " " term " " term ")"
              | "(con " hash " " uint " " term-list ")"
              | "(match " term " " arm-list ")"
              | "(perform " hash " " uint " " term-list ")"
              | "(handle " hash " " term " " op-list " " term ")"
              | "(fix " type " " term " " term ")"
              | "(hole " type " " term-list ")"
              | "(if " term " " term " " term ")")
term-list   ::= "(" (term (" " term)*)? ")"
arm         ::= "(" uint " " uint " " term ")"
arm-list    ::= "(" (arm (" " arm)*)? ")"
op          ::= "(" uint " " term ")"
op-list     ::= "(" (op (" " op)*)? ")"

literal     ::= ("(lit unit)"
              | "(lit bool " bool ")"
              | "(lit i64 " i64 ")"
              | "(lit f64 " f64 ")"
              | "(lit text " string ")"
              | "(lit bytes " bytes ")")
bool        ::= "true" | "false"
uint        ::= "0" | [1-9] [0-9]*
i64         ::= "0" | "-"? [1-9] [0-9]*
hash        ::= "0x" lower-hex{64}
f64         ::= "0x" lower-hex{16}
bytes       ::= "0x" (lower-hex lower-hex)*
lower-hex   ::= [0-9a-f]
string      ::= "\"" string-char* "\""
string-char ::= [^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" hex{4})
hex         ::= [0-9a-fA-F]
